# Sem estas variáveis o app roda em modo demonstração (dados fictícios no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Número do WhatsApp da loja (só dígitos, com DDI), usado no cardápio online.
VITE_STORE_WHATSAPP=
# Força o modo demonstração mesmo com Supabase configurado.
VITE_DEMO_MODE=false

# Somente no servidor (Vercel), para /api/assistente:
VITE_ANTHROPIC_API_KEY=
